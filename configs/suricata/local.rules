alert icmp any any -> $HOME_NET any (msg:"TEST ICMP ping detecte"; itype:8; sid:1000001; rev:1;)
alert http any any -> $HOME_NET 80 (msg:"LOCAL SQLi attempt detected"; flow:to_server,established; content:"'"; http_uri; content:"OR"; http_uri; nocase; sid:1000002; rev:1; classtype:web-application-attack;)
alert tcp any any -> $HOME_NET 80 (msg:"LOCAL Path traversal attempt detected"; content:"../"; sid:1000003; rev:3; classtype:web-application-attack;)
alert tcp any any -> $HOME_NET 22 (msg:"LOCAL Possible SSH bruteforce"; flags:S; threshold:type both, track by_src, count 3, seconds 20; sid:1000004; rev:2; classtype:attempted-recon;)
alert tcp any any -> $HOME_NET any (msg:"LOCAL Possible SYN flood"; flags:S; threshold:type both, track by_dst, count 50, seconds 5; sid:1000005; rev:1; classtype:attempted-dos;)
